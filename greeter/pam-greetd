#%PAM-1.0
# Login through greetd, on Arch's stacks (system-local-login pulls in system-login and system-auth).
# Plus gnome-keyring so the typed password unlocks (or on first login creates) the "login" keyring.
auth      include    system-local-login
auth      optional   pam_gnome_keyring.so
account   include    system-local-login
session   include    system-local-login
session   optional   pam_gnome_keyring.so auto_start
